PROJECT_NAME=
PROJECT_DESCRIPTION=

DEBUG=False
SECRET_KEY=

SQL_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

SQL_HOST=movie_db
SQL_PORT=5432
SQL_OPTIONS=-c search_path=public,content
DATABASE_TYPE=postgres

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# Bootstrap-учётка (общая для admin_panel и auth_service). Пароль от 8 символов.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ETL / Elasticsearch
POSTGRES_HOST=movie_db
ES_HOST=elasticsearch
ES_PORT=9200
ES_MOVIES_INDEX_NAME=movies
ES_GENRES_INDEX_NAME=genres
ES_PERSONS_INDEX_NAME=persons
ETL_BATCH_SIZE=100
ETL_SLEEP_INTERVAL=60
ETL_STATE_FILE=/app/state/state.json

# Async API
REDIS_HOST=async_api_redis
REDIS_PORT=6379

# Auth Service (все переменные сервиса авторизации с префиксом AUTH_)
AUTH_POSTGRES_USER=
AUTH_POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=
AUTH_SECRET_KEY=
AUTH_SESSION_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7


# Auth Service <- Async API / Admin Panel (интеграция с auth_service)
AUTH_REQUEST_TIMEOUT=1.5
AUTH_SERVICE_TIMEOUT=3
AUTH_SERVICE_ADMIN_ROLE=admin
AUTH_SERVICE_BREAKER_FAILURE_THRESHOLD=3
AUTH_SERVICE_BREAKER_RESET_TIMEOUT=30

# Auth Service -> notification_api (S10_T7, issue #100): приветственное
# письмо при регистрации, уведомление о смене пароля. NOTIFICATIONS_API_KEY —
# общий ключ, уже задан в секции notification_api ниже.
AUTH_NOTIFICATIONS_API_URL=http://notification_api:8000/api/v1
AUTH_NOTIFICATIONS_API_TIMEOUT=5

# notification_worker -> Auth Service (S10_T3, issue #96): internal-эндпоинт
# профиля по user_id, без JWT конечного пользователя (у воркера из Kafka
# есть только user_id). Пусто = проверка X-Internal-Api-Key отключена (dev).
AUTH_INTERNAL_API_KEY=

# Auth Service Rate Limiter
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRATEGY=moving-window
# Дифференцированные лимиты для разных типов операций
RATE_LIMIT_STRICT=5/minute
RATE_LIMIT_MODERATE=10/minute
RATE_LIMIT_STANDARD=30/minute
RATE_LIMIT_RELAXED=60/minute
RATE_LIMIT_DEFAULT=100/minute


# OAuth (Google) — client_id/secret из Google Cloud Console, redirect_uri
# должен точно совпадать с зарегистрированным там значением.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/google/callback


# Jaeger
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces

# Event API (сбор пользовательских действий, публикация в Kafka)
EVENTS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EVENTS_KAFKA_TOPIC_CLICKS=analytics.clicks.v1
EVENTS_KAFKA_TOPIC_PAGEVIEWS=analytics.pageviews.v1
EVENTS_KAFKA_TOPIC_CUSTOM_EVENTS=analytics.custom_events.v1
# Пусто = проверка X-API-Key отключена (dev)
EVENTS_API_KEY=
EVENTS_BATCH_MAX_SIZE=100
EVENTS_RATE_LIMIT_EVENTS=200/minute
EVENTS_RATE_LIMIT_DEFAULT=300/minute

# Analytics ETL - Kafka (analytics_etl consumer)
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ANALYTICS_KAFKA_CONSUMER_GROUP=analytics_etl
ANALYTICS_KAFKA_TOPICS=analytics.clicks.v1,analytics.pageviews.v1,analytics.custom_events.v1

# Analytics ETL - ClickHouse
ANALYTICS_CLICKHOUSE_HOST=clickhouse
ANALYTICS_CLICKHOUSE_PORT=8123
ANALYTICS_CLICKHOUSE_DATABASE=analytics
ANALYTICS_CLICKHOUSE_USER=default
ANALYTICS_CLICKHOUSE_PASSWORD=

# Analytics ETL - Settings
ANALYTICS_ETL_BATCH_SIZE=1000
ANALYTICS_ETL_FLUSH_INTERVAL=5
ANALYTICS_ETL_STATE_DIR=/app/state
ANALYTICS_ETL_MEMORY_WARN_MB=500
ANALYTICS_ETL_MEMORY_CRITICAL_MB=800
ANALYTICS_ETL_BACKOFF_START=0.1
ANALYTICS_ETL_BACKOFF_BORDER=10.0
ANALYTICS_ETL_BACKOFF_MAX=0

# UGC Service — MongoDB (шардированный кластер с keyFile-аутентификацией)
# root — административная учётка (создаётся в mongo_init через localhost exception),
# ugc — учётка приложения (readWrite + dbAdmin на базе ugc_service).
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_UGC_USER=
MONGO_UGC_PASSWORD=

# Sentry
SENTRY_DSN_ASYNC_API=
SENTRY_DSN_AUTH_SERVICE=
SENTRY_DSN_EVENT_API=
SENTRY_DSN_UGC_SERVICE=
SENTRY_DSN_ADMIN_PANEL=
SENTRY_DSN_NOTIFICATION_API=
SENTRY_DSN_NOTIFICATION_WORKER=

# Notification API (приём заявок на уведомления, публикация в Kafka —
# docs/notification_requests_contract.md)
NOTIFICATIONS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NOTIFICATIONS_KAFKA_TOPIC_REQUESTS=notifications.requests.v1
# Пусто = проверка X-API-Key отключена (dev)
NOTIFICATIONS_API_KEY=
NOTIFICATIONS_BATCH_MAX_SIZE=100
NOTIFICATIONS_MAX_RECIPIENTS=1000
NOTIFICATIONS_RATE_LIMIT_NOTIFICATIONS=200/minute
NOTIFICATIONS_RATE_LIMIT_DEFAULT=300/minute

# === Notification Admin Panel ===
NOTIFICATION_POSTGRES_USER=notify_user
NOTIFICATION_POSTGRES_PASSWORD=notify_secret
NOTIFICATION_POSTGRES_DB=notifications_db

# Notification Worker (S10_T3, issue #96): render-стадия читает
# notifications.requests.v1, обогащает профилем из auth_service, рендерит
# шаблон, публикует в notifications.ready.v1; email-sender-стадия читает
# notifications.ready.v1 и шлёт письма — docs/notification_requests_contract.md
NOTIFICATION_WORKER_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
NOTIFICATION_WORKER_KAFKA_TOPIC_REQUESTS=notifications.requests.v1
NOTIFICATION_WORKER_KAFKA_TOPIC_READY=notifications.ready.v1
NOTIFICATION_WORKER_KAFKA_CONSUMER_GROUP_RENDER=notification_worker_render
NOTIFICATION_WORKER_KAFKA_CONSUMER_GROUP_SEND=notification_worker_email_sender
NOTIFICATION_WORKER_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_WORKER_RETRY_BACKOFF_SECONDS=2
NOTIFICATION_WORKER_PARTITION_PAUSE_SECONDS=30
NOTIFICATION_WORKER_SEND_LEASE_SECONDS=120
NOTIFICATION_WORKER_TEMPLATE_CACHE_TTL_SECONDS=60
NOTIFICATION_WORKER_LOG_LEVEL=INFO

# Notification Worker — SMTP (dev/test: MailHog, письма никуда не уходят
# наружу, видны на http://localhost:8025)
NOTIFICATION_WORKER_SMTP_HOST=mailhog
NOTIFICATION_WORKER_SMTP_PORT=1025
NOTIFICATION_WORKER_SMTP_USER=
NOTIFICATION_WORKER_SMTP_PASSWORD=
NOTIFICATION_WORKER_SMTP_FROM_EMAIL=noreply@repospmd.local
NOTIFICATION_WORKER_SMTP_USE_TLS=false
NOTIFICATION_WORKER_SMTP_TIMEOUT=10
NOTIFICATION_WORKER_SMTP_POOL_SIZE=3

