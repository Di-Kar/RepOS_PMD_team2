PROJECT_NAME=
PROJECT_DESCRIPTION=

DEBUG=False
SECRET_KEY=

SQL_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

SQL_HOST=movie_db
SQL_PORT=5432
SQL_OPTIONS=-c search_path=public,content
DATABASE_TYPE=postgres

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# Bootstrap-учётка (общая для admin_panel и auth_service). Пароль от 8 символов.
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ETL / Elasticsearch
POSTGRES_HOST=movie_db
ES_HOST=elasticsearch
ES_PORT=9200
ES_MOVIES_INDEX_NAME=movies
ES_GENRES_INDEX_NAME=genres
ES_PERSONS_INDEX_NAME=persons
ETL_BATCH_SIZE=100
ETL_SLEEP_INTERVAL=60
ETL_STATE_FILE=/app/state/state.json

# Async API
REDIS_HOST=async_api_redis
REDIS_PORT=6379

# Auth Service (все переменные сервиса авторизации с префиксом AUTH_)
AUTH_POSTGRES_USER=
AUTH_POSTGRES_PASSWORD=
AUTH_POSTGRES_DB=
AUTH_SECRET_KEY=
AUTH_SESSION_SECRET=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth (Google) — client_id/secret из Google Cloud Console, redirect_uri
# должен точно совпадать с зарегистрированным там значением.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/auth/oauth/google/callback

# Auth Service <- Async API / Admin Panel (интеграция с auth_service)
AUTH_REQUEST_TIMEOUT=1.5
AUTH_SERVICE_TIMEOUT=3
AUTH_SERVICE_ADMIN_ROLE=admin
AUTH_SERVICE_BREAKER_FAILURE_THRESHOLD=3
AUTH_SERVICE_BREAKER_RESET_TIMEOUT=30

# Jaeger
JAEGER_ENDPOINT=http://jaeger:4318/v1/traces

# Event API (сбор пользовательских действий, публикация в Kafka)
EVENTS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EVENTS_KAFKA_TOPIC_CLICKS=analytics.clicks.v1
EVENTS_KAFKA_TOPIC_PAGEVIEWS=analytics.pageviews.v1
EVENTS_KAFKA_TOPIC_CUSTOM_EVENTS=analytics.custom_events.v1
# Пусто = проверка X-API-Key отключена (dev)
EVENTS_API_KEY=
EVENTS_BATCH_MAX_SIZE=100
EVENTS_RATE_LIMIT_EVENTS=200/minute
EVENTS_RATE_LIMIT_DEFAULT=300/minute

# Analytics ETL - Kafka (analytics_etl consumer)
ANALYTICS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ANALYTICS_KAFKA_CONSUMER_GROUP=analytics_etl
ANALYTICS_KAFKA_TOPICS=analytics.clicks.v1,analytics.pageviews.v1,analytics.custom_events.v1

# Analytics ETL - ClickHouse
ANALYTICS_CLICKHOUSE_HOST=clickhouse
ANALYTICS_CLICKHOUSE_PORT=9000
ANALYTICS_CLICKHOUSE_DATABASE=analytics
ANALYTICS_CLICKHOUSE_USER=default
ANALYTICS_CLICKHOUSE_PASSWORD=

# Analytics ETL - Settings
ANALYTICS_ETL_BATCH_SIZE=1000
ANALYTICS_ETL_FLUSH_INTERVAL=5
ANALYTICS_ETL_STATE_DIR=/app/state
ANALYTICS_ETL_MEMORY_WARN_MB=500
ANALYTICS_ETL_MEMORY_CRITICAL_MB=800
ANALYTICS_ETL_BACKOFF_START=0.1
ANALYTICS_ETL_BACKOFF_BORDER=10.0
ANALYTICS_ETL_BACKOFF_MAX=0
